# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Either provide individual parameters or a full DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lab_management
DB_USER=postgres
DB_PASSWORD=postgres
# Cloud Postgres (Neon / Supabase) or local connection string
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Security & JWT Configuration
JWT_SECRET=lab-report-super-secret-jwt-key-change-in-production-vps-2026
JWT_EXPIRES_IN=7d

# Public QR Code & Online Report URL Configuration
# Clients scanning the QR will be directed to: ${CLIENT_BASE_URL}/reports/view/${qr_token}
CLIENT_BASE_URL=http://localhost:3000

# Report Storage
REPORT_STORAGE_DIR=./storage/reports
